{
  "name": "dancingmascots",
  "version": "1.0.1",
  "description": "Desktop overlay mascots that dance to the tempo of whatever you're listening to",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "gifuct-js": "^2.1.2",
    "koffi": "2.9.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "license": "MIT",
  "author": "DreamyAkemi",
  "build": {
    "appId": "com.dreamyakemi.dancingmascots",
    "productName": "Dancing Mascots",
    "files": [
      "src/**/*",
      "assets/*.png",
      "package.json",
      "node_modules/**/*",
      "!node_modules/koffi/build/koffi/{darwin_*,freebsd_*,linux_*,musl_*,openbsd_*,win32_arm64,win32_ia32}",
      "!node_modules/koffi/{doc,src,vendor,CHANGELOG.md}",
      "!node_modules/gifuct-js/demo"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ]
  }
}
